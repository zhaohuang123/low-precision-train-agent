+def install_on_model(models) -> bool:
+    """在**建好的模型**上装探针（调用点 = `qat_qsnr_get_model_wrapper`）。
+
+    ★ 只吞**运行期**装配异常 ⇒ `probe_invalid`（**不终止训练**；
+      判据 `observations.qsnr.watchdog.on_probe_invalid` 就是这么定的）。
+      **不吞**：① `QATProbeConfigError`（配置写错 ⇒ 当场炸穿：说好要测却没测，
+      是静默降级）；② `QSNRWatchdogTrip`（看门狗触发）。两者都是 `BaseException`
+      子类 ⇒ 这里的 `except Exception` 收不走它们。
+    """
+    st = _STATE
+    if not probe_enabled():
+        _say("QAT_QSNR_PROBE 未开 ⇒ 探针不装；(1.2) 的 QSNR 半边记「未测」")
+        return False
+    try:
+        return _install_impl(models)
+    except Exception as exc:  # noqa: BLE001
+        st["probe_invalid"] = True
+        st["probe_invalid_reason"] = f"装配失败：{type(exc).__name__}: {exc}"
+        _say("⚠ 探针装配失败 ⇒ probe_invalid（**不终止训练**，但 QSNR 序列不可用）："
+             f"{type(exc).__name__}: {exc}")
+        # ★ 装配失败写**旁文件**，不写主文件：主文件是判据 (A) 点名的产物，
+        #   只能由"真的采到样的训练进程"写。别处（例如只 import 了本模块的进程）
+        #   装配失败时若也写主文件，就会把一份好数据盖成 probe_invalid。
+        try:
+            _atomic_write_json(os.path.join(_out_dir(),
+                                            f"eval_clamp_qsnr.probe_invalid.rank{_rank()}.json"),
+                               {"probe_invalid": True, "reason": st["probe_invalid_reason"],
+                                "rank": _rank(), "pid": os.getpid(), "generated_at": _now()})
+        except Exception as exc2:  # noqa: BLE001
+            _say(f"⚠ probe_invalid 旁文件也写不出去：{type(exc2).__name__}: {exc2}")
+        return False
+
+
+def _install_impl(models) -> bool:
+    st = _STATE
+    ms = list(models) if isinstance(models, (list, tuple)) else [models]
+    ms = [m for m in ms if m is not None]
+    if len(ms) != 1:
+        raise RuntimeError(
+            f"models 有 {len(ms)} 块（PP>1？）⇒ 标定批与逐层聚合的口径没定义，本轮不猜"
+        )
+    outer = ms[0]
+    inner = _unwrap(outer)
+
+    every = sample_every()
+    last = _train_iters()
+    if last <= 0:
+        raise QATProbeConfigError("取不到 args.train_iters ⇒ 采样步表无法确定")
+    # ★ **步号来源已从"数模型前向次数"改成"框架真实 iteration**
+    #   （`args.curr_iteration`，见 `_real_iteration()`）。所以：
+    #     · 训练期多出的任何一次模型前向（mid-training validation / 手工 eval）
+    #       **不再**让步号错位 —— validation 期间 `args.curr_iteration` 不变
+    #       ⇒ val 前向与刚跑完的训练步同号 ⇒ 被 `seen_step` 去重挡掉；
+    #     · 因此原来那条"eval_interval>0 且 eval_iters>0 ⇒ 拒绝启动"的守卫
+    #       **废除**，降级成下面一条 note（判据 (A) 的产物 JSON 里看得见）。
+    #     · 纪律不变：取不到真实步号 ⇒ `_real_iteration()` 抛 `QATProbeConfigError`
+    #       （响亮报错，不允许静默继续；也不靠把 --eval-interval 置 0 来绕）。
+    #
+    #   ★ 口径仍是**事实描述、不声称等价于 `args.do_valid`**：
+    #     · `Megatron-LM/megatron/training/training.py:2388`
+    #       `do_valid = valid_dataloader is not None and args.eval_iters > 0` —— 不含 skip_train；
+    #     · `:791` `if not args.skip_train: … else: iteration = args.iteration` —— 只是跳过训练循环；
+    #     · `:825` `if args.do_valid:` —— 跳过训练循环之后照样做整轮 validation 前向。
+    #
+    #   守卫（本行即事实口径）：
+    #
+    #         eval_interval > 0  **且**  eval_iters > 0   ⇒  只记 note，**允许启动**
+    #
+    #   ★ 残留（写清、不掩盖）：`skip_train=True` 时训练循环根本不跑
+    #     ⇒ `args.curr_iteration` 从未被赋值 ⇒ 取真实步号会**响亮报错**
+    #     （这是纪律要求的行为，不是绕过）。
+    from megatron.training.global_vars import get_args as _get_args
+    _a = _get_args()
+    _ei = int(getattr(_a, "eval_interval", 0) or 0)
+    _eit = int(getattr(_a, "eval_iters", 0) or 0)
+    _skip_train = bool(getattr(_a, "skip_train", False))
+    _extra = _ei > 0 and _eit > 0
+    st["notes"].append(
+        "★步号来源 = 框架真实 iteration（`args.curr_iteration` + 1，"
+        "Megatron 在 train_step 之前赋值：MindSpeed-LLM/mindspeed_llm/training/training.py:733）；"
+        "**不再**用前向计数推步号 ⇒ validation 前向不改步号、不与训练步混淆。"
+        f"口径核对：eval_interval={_ei} eval_iters={_eit} skip_train={_skip_train} "
+        f"⇒ mid-training validation={'会有' if _extra else '不会有'}；"
+        "旧守卫（eval_interval>0 且 eval_iters>0 ⇒ 拒绝启动）**已废除，改为允许启动**。"
+        "★ 本条件**不等价于** args.do_valid（training.py:2388 的 do_valid 不含 skip_train，"
+        "而 :791 跳过训练循环后 :825 照样做整轮 validation）。"
+        "★ 残留：skip_train=True 时训练循环不跑、args.curr_iteration 从未赋值 "
+        "⇒ 取不到真实步号 ⇒ 按纪律**响亮报错**（不静默继续）。"
+    )
+    _say("步号来源=args.curr_iteration+1（框架真实 iteration；前向计数只作诊断）")
+    _say(f"口径：eval_interval={_ei} eval_iters={_eit} skip_train={_skip_train} "
+         f"⇒ {'**会有** mid-training validation（不影响步号）' if _extra else '无 mid-training validation'}"
+         " ⇒ **允许启动**")
+    steps = sample_steps(every, last)
+    n_micro = _n_microbatches()
+    if n_micro <= 0:
+        raise RuntimeError(f"get_num_microbatches() = {n_micro} ⇒ 步号无法判定")
+
+    modules, meta, fused = [], {}, []
+    for name, mod in inner.named_modules():
+        parsed = _is_quantized_linear(name)
+        if parsed is None:
+            continue
+        idx, slot = parsed
+        canon = canonical_of(idx, slot)
+        if not isinstance(canon, str):
+            fused.append(f"{name} → {list(canon)}")
+            canon = f"model.layers.{idx}.{slot.replace('.', '_')}(融合)"
+        if getattr(mod, "weight", None) is None:
+            raise RuntimeError(f"{name} 命中量化槽位但没有 weight ⇒ 装置自相矛盾")
+        modules.append((canon, name, slot, mod))
+        meta[canon] = slot
+    if not modules:
+        raise RuntimeError("一个被量化线性层都没枚举到 ⇒ 探针没挂上（拒绝静默继续）")
+
+    st["hooks"] = [mod.register_forward_pre_hook(_make_act_hook(canon))
+                   for canon, _n, _s, mod in modules]
+    out_layer = getattr(inner, "output_layer", None)
+    if isinstance(out_layer, torch.nn.Module):
+        st["hooks"].append(out_layer.register_forward_pre_hook(_cut_at_output_layer))
+        st["notes"].append("定向探针前向在 output_layer 之前被截断（不算 logits，省 ≈2.5 GB 临时张量）")
+    else:
+        st["notes"].append("本模型没有可钩的 output_layer ⇒ 定向探针前向会算完（含 logits）")
+
+    st.update(enabled=True, installed=True, inner=inner, outer=outer, modules=modules,
+              n_micro=n_micro, sample_steps=steps, every=every, last_step=last,
+              modules_meta=meta)
+    st["hooks"].append(outer.register_forward_pre_hook(_outer_pre_hook, with_kwargs=True))
+    if fused:
+        st["notes"].append("融合槽位（训练侧无法拆成 1:1，家族归 `其它`）：" + "; ".join(fused))
+    st["notes"].append(
+        "标定批 = 本 rank 的第 1 个 micro-batch（每步的第 1 个 MB 用同一份 token/position/"
+        "attention 重跑一次前向）。DP=8 时各 rank 各持一片；**跨 rank 聚合未做**"
+        "（训练期不引入额外集合通信）；rank 0 的产物即判据 `(A)` 点名的 "
+        "evidence/eval_clamp_qsnr.json。"
+    )
+    st["notes"].append(
+        "lm_head（mcore 侧 output_layer）：训练侧**没有** `W4A4_QHEAD` 这个键"
+        "（`grep -rn W4A4_QHEAD MindSpeed MindSpeed-LLM` = 0 命中，它只在评测驱动里）"
+        "⇒ 训练侧它是否进假量化**本探针未确认**；它**不进**本报告的逐层聚合。"
+        "★ 口径（别把两个数混起来）：项目里那个 **252** = **HF 侧** 7 个投影 × 36 层"
+        "（旋转的逐层表用那个口径）；mcore 侧把 q/k/v 融合成 qkv、gate/up 融合成 fc1"
+        "⇒ 被量化槽位 = 36 层 × **4** = **144**。本报告的逐层表按 **mcore 的 144 个槽位**出。"
+    )
+
+    # ★ 印**生效值**，不印模块默认值（0.18.28）：覆盖来自 `QAT_QSNR_DROP_DB`/`QAT_QSNR_FLOOR_DB`，
+    #   模块常量只是默认；两者混印会让人照着日志调阈值却调了个寂寞。
+    _wd_drop, _wd_floor = _watchdog_cfg()
+    _say(f"installed layers={len(modules)} sampling={steps} n_microbatches={n_micro} "
+         f"out={_qsnr_path(_rank())} calib_batch=fixed(first micro-batch of each step) "
+         f"watchdog=(drop>{_wd_drop}dB vs step{BASELINE_STEP} | floor<{_wd_floor}dB)"
+         f" [defaults {DROP_DB}/{AGG_FLOOR_DB}dB，覆盖来自 QAT_QSNR_DROP_DB/QAT_QSNR_FLOOR_DB]")
+    return True
