+class QATProbeConfigError(BaseException):
+    """**配置**类错误（不是运行期异常）：`QAT_QSNR_EVERY` 非法、检测到额外模型前向等。
+
+    ★ 为什么必须是 `BaseException` 子类（reviewer §2-4）：
+      `install_on_model` 的 `except Exception` 只该吞**运行期**装配异常（记
+      `probe_invalid`、训练继续 —— 判据 `on_probe_invalid` 允许）。
+      配置写错了却照常跑 = "声明了要测、实际没测"的静默降级 ⇒ 必须当场炸穿，
+      不许被那个 broad except 收走。`_ProbeForwardDone` 同理。
+    """
+
+
+class _ProbeForwardDone(BaseException):
+    """定向探针前向的**提前结束**信号（在 output_layer 的 pre-hook 里抛）。
+
+    为什么要提前结束：`post_process=True` 的模型会算 `[seq, 151936]` 的 logits
+    （bf16 下 ≈2.5 GB 的临时张量）—— 我们只要**逐层激活**，不要 logits。
+    继承 `BaseException` ⇒ 不会被前面任何 broad `except Exception` 吃掉。
+    """
+
