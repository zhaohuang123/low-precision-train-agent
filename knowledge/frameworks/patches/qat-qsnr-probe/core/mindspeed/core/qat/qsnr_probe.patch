+def _rank() -> int:
+    try:
+        if torch.distributed.is_available() and torch.distributed.is_initialized():
+            return int(torch.distributed.get_rank())
+    except Exception:  # noqa: BLE001
+        pass
+    return int(os.environ.get("RANK", os.environ.get("LOCAL_RANK", "0")) or 0)
