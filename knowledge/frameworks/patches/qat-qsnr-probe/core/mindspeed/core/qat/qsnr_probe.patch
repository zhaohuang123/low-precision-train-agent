+def sample_every() -> int:
+    raw = (os.environ.get("QAT_QSNR_EVERY") or "").strip()
+    if not raw:
+        return 50
+    try:
+        v = int(raw)
+    except ValueError:
+        raise QATProbeConfigError(
+            f"QAT_QSNR_EVERY={raw!r} 不是整数 ⇒ 拒绝启动（不猜一个默认间隔）")
+    if v < 1:
+        raise QATProbeConfigError(f"QAT_QSNR_EVERY={v} < 1 ⇒ 拒绝启动")
+    return v
+
+
+def sample_steps(every: int, last: int) -> list:
+    """采样步表。`QAT_QSNR_EVERY=50` 时**逐字**用判据冻结的那一组。"""
+    if every == 50:
+        base = list(FROZEN_STEPS_EVERY_50)
+    else:
+        base = sorted({1, 10} | set(range(every, last + 1, every)))
+    return sorted({k for k in base if 1 <= k <= last} | {last})
+
+
+def qsnr_db(x, xhat):
+    """`QSNR = 10 * log10( Σ x² / Σ (x − x̂)² )`（判据 `observations.qsnr.definition`）。
+
+    返回 `(db, num, den, exact)`：
+      · `den == 0` ⇒ **精确量化**（假量化是恒等）⇒ `db=None, exact=True`（不是"无穷好"，
+        也不是 0 dB —— 记 null ＋ 原因，聚合时按"无误差"计 num、den 各加它自己的值）；
+      · `num`/`den` 非有限 ⇒ `db=None`（不许把它混进聚合）。
+    """
+    xf = x.detach().to(torch.float32)
+    hf = xhat.detach().to(torch.float32)
+    num = float((xf * xf).sum())
+    den = float(((xf - hf) ** 2).sum())
+    if not math.isfinite(num) or not math.isfinite(den):
+        return None, num, den, False
+    if den == 0.0:
+        return None, num, 0.0, True
+    if num == 0.0:
+        return None, 0.0, den, False       # 全零张量 ⇒ QSNR 无定义（判据列为探针异常）
+    return 10.0 * math.log10(num / den), num, den, False
+
+
+def _aggregate(entries: dict):
+    """按"分子分母各自求和再取 dB"聚合（不是把各层 dB 求平均 —— 那样大层与小层等权）。"""
+    num = den = 0.0
+    n_layers = n_exact = 0
+    for e in entries.values():
+        n_layers += 1
+        if e.get("exact"):
+            n_exact += 1
+        if e.get("num") is not None and math.isfinite(e["num"]):
+            num += e["num"]
+        if e.get("den") is not None and math.isfinite(e["den"]):
+            den += e["den"]
+    db = None if (den == 0.0 or num == 0.0) else 10.0 * math.log10(num / den)
+    return {"aggregate_db": db, "sum_num": num, "sum_den": den,
+            "n_layers": n_layers, "n_layers_exact": n_exact}
+
+
+def _family_aggregate(entries: dict, modules_meta: dict) -> dict:
+    fams: dict = {}
+    for name, slot in modules_meta.items():
+        fam = FAMILY_OF_SLOT.get(slot, "其它")
+        fams.setdefault(fam, {})
+        if name in entries:
+            fams[fam][name] = entries[name]
+    return {fam: _aggregate(v)["aggregate_db"] for fam, v in fams.items()}
+
+
+def _labels():
+    """`QAT_QSNR_LABELS`（JSON 对象）→ dict；没给/解析不了 ⇒ None（不猜、不报错）。
+
+    用途只是"产物里带上调用方的身份标签"，读不到不影响度量本身 ⇒ 不做 fail-loud。
+    """
+    raw = os.environ.get("QAT_QSNR_LABELS")
+    if not raw:
+        return None
+    try:
+        got = json.loads(raw)
+    except ValueError:
+        return {"_raw": raw}
+    return got if isinstance(got, dict) else {"_raw": raw}
+
