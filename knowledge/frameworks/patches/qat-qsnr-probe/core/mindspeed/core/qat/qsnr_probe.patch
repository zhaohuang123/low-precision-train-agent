+# 槽位表：本探针只借它做两件事 —— 判"这是不是一个被量化的线性层"，以及给这层一个 HF
+# 规范名（`model.layers.<i>.self_attn.o_proj` 这种，只用作 JSON 的键与分层聚合的归组）。
+#
+# ★ 框架里带 `layer_exempt`（层豁免特性）时**一定**用框架那份 —— 两张表分家才是真正的坑。
+# ★ 上游 MindSpeed 没有这个模块时用下面这份实现：它与框架的槽位命名逐字一致
+#   （qkv/fc1 是融合槽位、o_proj/fc2 一对一），因此 JSON 键的形状与本框架里的完全一样。
+# ═══════════════════════════════════════════════════════════════════════════
+try:  # pragma: no cover - 取决于框架里有没有 layer_exempt
+    from mindspeed.core.qat.layer_exempt import (  # type: ignore[import-not-found]
+        FUSED, ONE_TO_ONE, canonical_of, parse_native)
+except Exception:  # noqa: BLE001 - 缺模块/版本不符都退回内置实现，但要留下痕迹
+    import re as _re
+
+    ONE_TO_ONE = {
+        "self_attention.linear_proj": "self_attn.o_proj",
+        "mlp.linear_fc2": "mlp.down_proj",
+    }
+    FUSED = {
+        "self_attention.linear_qkv": ("self_attn.q_proj", "self_attn.k_proj",
+                                      "self_attn.v_proj"),
+        "mlp.linear_fc1": ("mlp.gate_proj", "mlp.up_proj"),
+    }
+    _CANON_PREFIX = "model"
+    _NATIVE_RE = _re.compile(
+        r"(?:^|\.)layers\.(?P<idx>\d+)\.(?P<slot>"
+        + "|".join(_re.escape(s) for s in tuple(ONE_TO_ONE) + tuple(FUSED)) + r")$")
+
+    def parse_native(name):
+        """`…decoder.layers.<i>.<slot>` → (idx, slot)；不是这四个槽位就 None。
+
+        前缀（DDP/Float16Module 的 `module.module.`）**故意忽略**：包装层不影响
+        "这是哪一层哪一槽位"。
+        """
+        m = _NATIVE_RE.search(name)
+        if m is None:
+            return None
+        return int(m.group("idx")), m.group("slot")
+
+    def canonical_of(idx, slot):
+        """训练侧槽位 → HF 规范名（1:1 时是单个名字；融合槽位返回元组）。"""
+        if slot in ONE_TO_ONE:
+            return f"{_CANON_PREFIX}.layers.{idx}.{ONE_TO_ONE[slot]}"
+        if slot in FUSED:
+            return tuple(f"{_CANON_PREFIX}.layers.{idx}.{half}" for half in FUSED[slot])
+        raise KeyError(slot)
+
+TAG = "[qat-qsnr]"
