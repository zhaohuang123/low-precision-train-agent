+# ---------------------------------------------------------------------------
+# 钩子
+# ---------------------------------------------------------------------------
+def _make_act_hook(canon: str):
+    def _hook(module, inputs):  # noqa: ARG001
+        st = _STATE
+        if not st["capturing"]:
+            return
+        if not inputs or not torch.is_tensor(inputs[0]):
+            st["act"][canon] = {"qsnr_db": None, "num": None, "den": None,
+                                "error": "该模块这一跳没有张量输入（形状/取输入不符）"}
+            return
+        x = inputs[0]
+        try:
+            fn = _kernel_fn()
+            xhat = fn(x.detach(), 2.0, 3.0, -1)
+            db, num, den, exact = qsnr_db(x, xhat)
+            st["act"][canon] = {"qsnr_db": db, "num": num, "den": den, "exact": exact,
+                                "dtype": str(x.dtype), "shape": list(x.shape)}
+        except Exception as exc:  # noqa: BLE001
+            st["act"][canon] = {"qsnr_db": None, "num": None, "den": None,
+                                "error": f"{type(exc).__name__}: {exc}"}
+
+    return _hook
+
+
+def _cut_at_output_layer(module, inputs):  # noqa: ARG001
+    if _STATE["capturing"]:
+        raise _ProbeForwardDone()
+    return None
+
+
+def _outer_pre_hook(module, args, kwargs):  # noqa: ARG001
+    st = _STATE
+    if not st["installed"] or st["probe_invalid"]:
+        return None
+    if st["capturing"]:
+        return None                      # 定向探针自己引起的（本探针只钩外层，理论上到不了这里）
+    st["n_fwd"] += 1                     # ★只作诊断计数，**不再**参与步号
+    # ★ 步号的**唯一**来源 = 框架真实 iteration（取不到 ⇒ 响亮报错）。
+    #   框架 iteration 是 0-based；判据冻结的采样步表 {1,10,50,150,250,300} 与旧口径
+    #   （第 1 个 GBS ⇒ step=1）都是 1-based ⇒ `+ 1`。
+    step = _real_iteration() + 1
+    # ★ "每步只在第 1 个 micro-batch 上干活" 的等价写法：
+    #   真实步号**变了**才是新的一步。同一训练步的后续 micro-batch 步号相同 ⇒ 跳过；
+    #   mid-training validation 期间 `args.curr_iteration` **不变** ⇒ 与刚跑完的
+    #   训练步同号 ⇒ 也在这里被跳过（validation 前向因此**不进** QSNR 序列）。
+    if step == st["seen_step"]:
+        return None
+    st["seen_step"] = step
+    if step not in st["sample_steps"]:
+        return None
+    try:
+        calib = _extract_batch(args, kwargs)
+        # ★ 只对**张量** detach，非张量（例如 `position_ids=None`）原样保留
+        #   —— 回放 `st["inner"](*st["calib"])` 是**位置参数**，抽掉一个 `None` 会让后面的
+        #   实参整体错位（第二颗雷）。
+        # ★ 而且这两行原来在 try **之外**：一崩就穿到训练循环 ⇒ 本模块自称的
+        #   "不终止训练 / 降级 probe_invalid" 根本没生效（tester 第三次冒烟就是这么崩的）。
+        #   挪进 try 是**防御纵深**：任何取参/存参的意外都只降级、不崩训练。
+        if st["calib"] is None:
+            st["calib"] = [x.detach() if isinstance(x, torch.Tensor) else x for x in calib]
+    except Exception as exc:  # noqa: BLE001
+        _mark_invalid(f"取不到标定批输入：{type(exc).__name__}: {exc}")
+        return None
+    try:
+        _sample(step)
+    except QSNRWatchdogTrip:
+        raise
+    except Exception as exc:  # noqa: BLE001
+        _mark_invalid(f"采样第 {step} 步失败：{type(exc).__name__}: {exc}")
+    return None
+
+
+def _extract_batch(args, kwargs):
+    """取标定批：**统一成恰好 3 槽** `[input_ids, position_ids, attention_mask]`。
+
+    ★ 两支**必须对称**（tester 第三次真卡冒烟：8/8 rank 同帧崩）：
+      位置支原来只判**个数**（`len(args) >= 3`）、不判**元素**，而关键字支会把 `None` 滤掉
+      ⇒ 不对称。于是 `model(tokens, None, attention_mask)` 这种调用（`reset_attention_mask=False`
+      时 `sft_trainer.py:162-163` 令 `position_ids=None`）会把一个 `None` 塞进 `calib`，
+      紧接着 `t.detach()` 抛 `AttributeError`。
+    ★ 但"对称"的做法是**保槽位**、不是**丢元素**：回放是 `st["inner"](*st["calib"])`
+      （**位置参数**），把中间的 `None` 抽掉会让 position_ids / attention_mask 整体错位
+      —— 那是第二颗雷。所以两支都返回**恰好 3 槽**、`None` 留在原位；
+    ★ 唯一的硬要求：输入 id 那一槽必须在（没有 tokens 的前向对探针没意义）。
+      真的完全认不出来时才 raise（由调用方降级成 `probe_invalid`，**不终止训练**）。
+    """
+    if args and len(args) >= 3:
+        slots = [args[0], args[1], args[2]]          # 位置：原样保序、保槽位
+        if slots[0] is not None:
+            return slots
+    elif kwargs:
+        ids = kwargs.get("input_ids")
+        if ids is None:
+            ids = kwargs.get("tokens")
+        slots = [ids, kwargs.get("position_ids"), kwargs.get("attention_mask")]
+        if slots[0] is not None:
+            return slots
+    raise RuntimeError("前向的入参形状不认识（既不是 (tokens, position_ids, attention_mask) "
+                       "位置参数，也不是同名关键字）")
+
+
+def _kernel_fn():
+    """**生效的**假量化内核（模块属性查找 ⇒ 评测侧 monkeypatch 过的也认）。
+
+    ★ 默认取 `w4a16_fake_quant`：QSNR 量的是"把这块张量按这个格式量化会坏多少"，
+      与训练当前用哪个 scheme 的**前向**无关；但不同位宽/粒度要换内核时，给
+      `QAT_QSNR_KERNEL=<module>:<attr>` 即可，不必改本文件。
+    ★ 解析不出来 ⇒ `QATProbeConfigError`（配置错要炸，不许静默退回默认内核）。
+    """
+    import importlib
+
+    spec = (os.environ.get("QAT_QSNR_KERNEL")
+            or "mindspeed.core.qat.w4a16_fake_quantization:w4a16_fake_quant")
+    mod_name, _, attr = spec.partition(":")
+    if not mod_name or not attr:
+        raise QATProbeConfigError(
+            f"QAT_QSNR_KERNEL={spec!r} 不是 <module>:<attr> 形状 ⇒ 拒绝猜一个内核")
+    try:
+        mod = importlib.import_module(mod_name)
+        fn = getattr(mod, attr)
+    except Exception as exc:  # noqa: BLE001
+        raise QATProbeConfigError(
+            f"QAT_QSNR_KERNEL={spec!r} 解析失败（{type(exc).__name__}: {exc}）") from exc
+    return fn
+
+
+def _mark_invalid(reason: str) -> None:
+    """降级：记 `probe_invalid`、**不终止训练** —— 但**必须响**（判据 `on_probe_invalid`）。
+
+    ★ 为什么要把"响"做足：`(E)` 要求 `evidence/eval_clamp_qsnr.json`
+      在场，而这份产物在 `probe_invalid` 时只是**记录契约**、不含可用 QSNR
+      ⇒ **静默降级 = 悄悄丢掉 (1.2) 的记录半边**。所以这里：① 打醒目 banner
+      （不只是 `⚠` 一行，训练日志里要一眼看见）；② 同一条也进 `st["notes"]`
+      ⇒ 跟着 `_write_current()` 落进产物 JSON（读的人和抽数的人都看得见）。
+    """
+    st = _STATE
+    if st["probe_invalid"]:
+        return
+    st["probe_invalid"] = True
+    st["probe_invalid_reason"] = reason
+    st["notes"].append(f"probe_invalid：{reason}")
+    _say("")
+    _say("████████████████████████████████████████████████████████████████")
+    _say("★ QSNR 探针已停用（probe_invalid）：**训练继续**，但本次运行的 QSNR 记录**缺失**。")
+    _say(f"★ 原因：{reason}")
+    _say("★ 这不是「量化误差没问题」，是「**没测**」——(1.2) 的 QSNR 半边按「未测」记，")
+    _say("   **不许**用别的数顶替（判据 observations.qsnr / (A) 的原话）。")
+    _say("████████████████████████████████████████████████████████████████")
+    try:
+        _write_current()
+    except Exception as exc:  # noqa: BLE001
+        _say(f"⚠ probe_invalid 现场落盘也失败了：{type(exc).__name__}: {exc}")
+
+
+# ---------------------------------------------------------------------------
+# 采样
+# ---------------------------------------------------------------------------
+def _sample(step: int) -> None:
+    st = _STATE
+    st["act"] = {}
+    st["capturing"] = True
+    try:
+        with torch.no_grad():
+            try:
+                st["inner"](*st["calib"])
+            except _ProbeForwardDone:
+                pass
+    finally:
+        st["capturing"] = False
+
+    act = {k: v for k, v in st["act"].items() if v.get("num") is not None}
+    if not act:
+        _mark_invalid(f"第 {step} 步：一个激活 QSNR 都没算出来（钩子没命中？）")
+        return
+
+    weight = {}
+    for canon, _native, _slot, mod in st["modules"]:
+        try:
+            w = mod.weight.detach()
+            xhat = _kernel_fn()(w, 2.0, 3.0, -1)
+            db, num, den, exact = qsnr_db(w, xhat)
+            weight[canon] = {"qsnr_db": db, "num": num, "den": den, "exact": exact,
+                             "dtype": str(w.dtype), "shape": list(w.shape)}
+        except Exception as exc:  # noqa: BLE001
+            weight[canon] = {"qsnr_db": None, "num": None, "den": None,
+                             "error": f"{type(exc).__name__}: {exc}"}
+
+    meta = st["modules_meta"]
+    agg_act, agg_w = _aggregate(act), _aggregate(weight)
+    combined = {**{f"act::{k}": v for k, v in act.items()},
+                **{f"w::{k}": v for k, v in weight.items()}}
+    agg_all = _aggregate(combined)
+
+    rec = {
+        "step": step,
+        "calibration_batch": "first micro-batch of the first GBS (fixed; re-forwarded each sample)",
+        "n_layers": len(meta),
+        "n_activation_recorded": len(act),
+        "aggregate_db": agg_all["aggregate_db"],
+        "weight": {**_agg_block(agg_w, _family_aggregate(weight, meta)), "layers": weight},
+        "activation": {**_agg_block(agg_act, _family_aggregate(act, meta)), "layers": act},
+    }
+    st["records"].append(rec)
+    st["by_step"][step] = agg_all["aggregate_db"]
+
+    w_db, a_db = agg_w["aggregate_db"], agg_act["aggregate_db"]
+    _say(f"step={step} aggregate_db={_fmt(agg_all['aggregate_db'])} "
+         f"(weight={_fmt(w_db)} activation={_fmt(a_db)}) "
+         f"layers={len(meta)} act_recorded={len(act)}")
+    _write_current()
+    _watchdog(step, agg_all["aggregate_db"], w_db, a_db)
+
+
+def _agg_block(agg, families):
+    return {"aggregate_db": agg["aggregate_db"], "sum_num": agg["sum_num"],
+            "sum_den": agg["sum_den"], "n_layers": agg["n_layers"],
+            "n_layers_exact": agg["n_layers_exact"], "by_family_db": families}
+
+
+def _fmt(v):
+    return "none" if v is None else f"{v:.3f}"
+
+
+def _write_current(reason: str | None = None) -> None:
+    st = _STATE
+    rank = _rank()
+    payload = {
+        # 身份**不由本模块猜**：调用方用 `QAT_QSNR_LABELS`（JSON 对象）给一串标签，
+        # 原样透传。框架侧不认识任何"轮次/任务"概念 —— 那是调用方的词。
+        "labels": _labels(),
+        "what": "online QSNR probe (record item, NOT a verdict; no cross-arm comparison)",
+        "definition": "QSNR = 10*log10( sum(x^2) / sum((x-xhat)^2) ) in dB; x pre-quant, xhat dequant",
+        "probe_enabled": probe_enabled(),
+        "installed": st["installed"],
+        "probe_invalid": st["probe_invalid"],
+        "probe_invalid_reason": reason or st["probe_invalid_reason"],
+        "rank": rank,
+        "n_microbatches_per_step": st["n_micro"],
+        "sampled_at_steps": st["sample_steps"],
+        "qat_qsnr_every": st["every"],
+        "train_iters": st["last_step"],
+        "qat_clamp_fix": os.environ.get("QAT_CLAMP_FIX", ""),
+        "qat_mask_fix": os.environ.get("QAT_MASK_FIX", ""),
+        "watchdog": {"drop_db": _watchdog_cfg()[0], "baseline_step": BASELINE_STEP,
+                     "absolute_floor_db": _watchdog_cfg()[1],
+                     "aggregate_used": "weight+activation pooled (sum(num)/sum(den))",
+                     "threshold_provenance": f"{_watchdog_cfg()[0]}/{_watchdog_cfg()[1]} dB 是工程护栏"
+                                             "（宁可早停），不是科学判据"},
+        "tripped": st["trip"],
+        "samples": st["records"],
+        "notes": st["notes"],
+        "generated_at": _now(),
+        "generated_by": "mindspeed/core/qat/qsnr_probe.py (instrument)",
+    }
+    _atomic_write_json(_qsnr_path(rank), payload)
+
+
+def _watchdog_cfg():
+    """看门狗的生效阈值：默认值 ＋ `QAT_QSNR_*` 覆盖；解析不出来 ⇒ `QATProbeConfigError`。
+
+    ★ 为什么放在函数里、而不是模块导入期读：环境要在**训练进程**里判定，
+      导入期读一次会让"先 import 后设环境"的用法静默失效（自检里就是这么用的）。
+    """
+    def _num(key, default):
+        raw = os.environ.get(key)
+        if raw is None or raw.strip() == "":
+            return default
+        try:
+            v = float(raw)
+        except ValueError:
+            raise QATProbeConfigError(f"{key}={raw!r} 不是数 ⇒ 拒绝猜一个阈值") from None
+        if v < 0:
+            raise QATProbeConfigError(f"{key}={raw!r} 是负数 ⇒ 拒绝猜一个阈值")
+        return v
+
+    return (_num("QAT_QSNR_DROP_DB", DROP_DB),
+            _num("QAT_QSNR_FLOOR_DB", AGG_FLOOR_DB))
+
+
+def _watchdog(step: int, agg, w_db, a_db) -> None:
+    st = _STATE
+    if agg is None:
+        return
+    if os.environ.get("QAT_QSNR_WATCHDOG", "1") == "0":
+        # 只要观测、不要 kill switch 的那一轮：明确关掉，并在每份产物里留一句，
+        # 免得读者以为"没触发"是"没问题"。
+        st["notes"] = list(dict.fromkeys(st["notes"] + [
+            "QAT_QSNR_WATCHDOG=0 ⇒ 本轮看门狗**关闭**："
+            "trip 永远是 null，但**不许**读成「量化误差没问题」"]))
+        return
+    drop_db, floor_db = _watchdog_cfg()
+    hit = None
+    base = st["by_step"].get(BASELINE_STEP)
+    drop = None if base is None else base - agg
+    if agg < floor_db:
+        hit = "absolute_floor"
+    elif step >= BASELINE_STEP and drop is not None and drop > drop_db:
+        hit = "relative_drop"
+    if hit is None:
+        return
+
+    trip = {
+        "tripped": True, "at_step": step, "rule_hit": hit,
+        "aggregate_db": agg, "weight_db": w_db, "activation_db": a_db,
+        "baseline_step": BASELINE_STEP, "baseline_db": base, "drop_db": drop,
+        "drop_threshold_db": drop_db, "absolute_floor_db": floor_db,
+        "rank": _rank(), "pid": os.getpid(),
+        "qsnr_file": _qsnr_path(_rank()),
+        "threshold_provenance": f"{drop_db}/{floor_db} dB 是工程护栏（宁可早停），"
+                                "不是科学判据",
+        "disposition": "当即停止该 run（raise ⇒ torchrun rc≠0）⇒ 该 run 按 EXPERIMENT_INVALID "
+                       "收尾；**不许原样重跑刷绿**（判据 observations.qsnr.watchdog.on_hit）",
+        "training_observation_md": "由**外部** watcher / scaffold/commands/check_nan_report.py "
+                                   "落 evidence/training_observation.md（本模块在训练进程里，"
+                                   "拿不到训练日志本身）",
+        "generated_at": _now(),
+    }
+    st["trip"] = trip
+    path = os.path.join(_out_dir(), "qsnr_watchdog_trip.json")
+    _atomic_write_json(path, trip)          # ★ 先落盘，再停 —— 顺序反了会丢现场
+    try:
+        _write_current()
+    except Exception as exc:  # noqa: BLE001
+        _say(f"⚠ 触发时写 QSNR 文件失败：{type(exc).__name__}: {exc}")
+    _say("=" * 74)
+    _say(f"★★ WATCHDOG TRIP ★★ step={step} rule={hit} aggregate_db={_fmt(agg)} "
+         f"baseline(step{BASELINE_STEP})={_fmt(base)} drop={_fmt(drop)} "
+         f"floor={floor_db} ⇒ 当即停止该 run（现场：{path}）")
+    _say("=" * 74)
+    raise QSNRWatchdogTrip(
+        f"QSNR 看门狗触发（step={step}, rule={hit}, aggregate_db={_fmt(agg)}）"
+        f"⇒ 当即停止训练；现场 {path}"
+    )
+
+
+# ---------------------------------------------------------------------------
+# get_model 的装饰器式补丁（与框架里其他 wrapper 同一形状）
+# ---------------------------------------------------------------------------
+def qat_qsnr_get_model_wrapper(orig):
+    """`megatron.training.training.get_model` 的**装饰器式**补丁。
+
+    ★ 函数名以 `wrapper` 结尾 ⇒ `MindSpeedPatchesManager` 按装饰器叠加，不是替换目标。
+    ★ `QAT_QSNR_PROBE` 没开时本函数**什么都不做**（不 import 实现、不挂钩子、不打印）。
+    """
+    import functools
+
+    @functools.wraps(orig)
+    def _get_model_with_qsnr(*args, **kwargs):
+        models = orig(*args, **kwargs)
+        install_on_model(models)
+        return models
+
+    return _get_model_with_qsnr
+
+
+def selftest() -> int:
+    """CPU 自检：**不碰 NPU、不跑训练**，只验探针的数学、调度、聚合、看门狗与落盘。"""
+    checks, fails = 0, []
+
+    def case(name, cond):
+        nonlocal checks
+        checks += 1
+        if not cond:
+            fails.append(name)
+        print(f"  [{'ok' if cond else 'FAIL'}] {name}")
+        return bool(cond)
+
+    # ① QSNR 定义（手算对照）
+    x = torch.tensor([1.0, 2.0, 3.0, 4.0])
+    xh = torch.tensor([1.0, 2.0, 3.0, 3.0])
+    db, num, den, exact = qsnr_db(x, xh)
+    want = 10 * math.log10(30.0 / 1.0)
+    case(f"QSNR 定义（手算 {want:.6f} dB）", abs(db - want) < 1e-9 and num == 30.0 and den == 1.0)
+    db2, _n, _d, ex2 = qsnr_db(x, x.clone())
+    case("精确量化 ⇒ db=None + exact=True（不是 inf，不是 0）", db2 is None and ex2 is True)
+    db3, _n2, _d2, _e3 = qsnr_db(torch.zeros(4), torch.ones(4))
+    case("全零张量 ⇒ db=None（无定义）", db3 is None)
+
+    # ② 采样步表 == 判据冻结的那一组
+    case("EVERY=50 ⇒ {1,10,50,150,250,300}（逐字）",
+         sample_steps(50, 300) == [1, 10, 50, 150, 250, 300])
+    case("EVERY=25 ⇒ 收尾步一定在里面", sample_steps(25, 300)[-1] == 300)
+
+    # ③ 聚合：分子分母各自求和（不是 dB 平均）
+    e = {"a": {"num": 9.0, "den": 1.0}, "b": {"num": 1.0, "den": 1.0}}
+    agg = _aggregate(e)
+    case("聚合 = 10log10(Σnum/Σden)", abs(agg["aggregate_db"] - 10 * math.log10(10 / 2)) < 1e-9)
+    case("精确层计入 n_layers_exact 且不污染聚合",
+         _aggregate({"a": {"num": 4.0, "den": 0.0, "exact": True}})["aggregate_db"] is None)
+
+    # ④ 看门狗：三条（不触发 / 相对地板 / 绝对地板）—— 用真函数，只把落点指向临时目录
+    saved_state, saved_env = dict(_STATE), dict(os.environ)
+    try:
+        with tempfile.TemporaryDirectory() as td:
+            os.environ["QAT_QSNR_OUT"] = td
+            _STATE.update(records=[], by_step={}, trip=None, notes=[], installed=True,
+                          probe_invalid=False, sample_steps=[1, 10], n_micro=8)
+            _STATE["by_step"] = {BASELINE_STEP: 30.0}          # 第 10 步的基准（_sample 在生产里写它）
+            _watchdog(10, 30.0, 31.0, 29.0)                     # 第 10 步本身（drop=0）
+            case("未越线 ⇒ 不触发（30 dB → 28 dB，跌 2 dB < 3）",
+                 _STATE["trip"] is None and _watchdog_silent(28.0))
+            try:
+                _watchdog(50, 26.0, 26.5, 25.5)
+                case("跌 4 dB > 3.0 ⇒ 触发相对地板", False)
+            except QSNRWatchdogTrip:
+                case("跌 4 dB > 3.0 ⇒ 触发相对地板（rule=relative_drop）",
+                     _STATE["trip"]["rule_hit"] == "relative_drop"
+                     and os.path.isfile(os.path.join(td, "qsnr_watchdog_trip.json")))
+            _STATE.update(trip=None, by_step={10: 30.0})
+            try:
+                _watchdog(150, 14.9, 15.0, 14.8)
+                case("聚合 14.9 dB < 15.0 硬地板 ⇒ 触发", False)
+            except QSNRWatchdogTrip:
+                case("聚合 14.9 dB < 15.0 硬地板 ⇒ 触发（rule=absolute_floor）",
+                     _STATE["trip"]["rule_hit"] == "absolute_floor")
+            # ④b 三个环境开关（阈值/关闭/标签）：框架侧只提供"默认值 + 覆盖"，
+            #     策略值不钉死在代码里。
+            _STATE.update(trip=None, by_step={10: 30.0})
+            os.environ["QAT_QSNR_FLOOR_DB"] = "5.0"
+            os.environ["QAT_QSNR_DROP_DB"] = "20.0"
+            case("阈值可由 QAT_QSNR_{DROP,FLOOR}_DB 覆盖（14.9 dB 不再触发 15.0 硬地板）",
+                 _watchdog_silent(14.9))
+            os.environ["QAT_QSNR_DROP_DB"] = "abc"
+            try:
+                _watchdog(50, 20.0, 21.0, 19.0)
+                case("阈值写坏 ⇒ 抛 QATProbeConfigError（不静默退回默认）", False)
+            except QATProbeConfigError:
+                case("阈值写坏 ⇒ 抛 QATProbeConfigError（不静默退回默认）", True)
+            del os.environ["QAT_QSNR_DROP_DB"]
+            del os.environ["QAT_QSNR_FLOOR_DB"]
+            _STATE.update(trip=None, by_step={10: 30.0})
+            os.environ["QAT_QSNR_WATCHDOG"] = "0"
+            case("QAT_QSNR_WATCHDOG=0 ⇒ 一律不触发，且 notes 写明「关了 ≠ 没问题」",
+                 _watchdog_silent(1.0) and any("WATCHDOG=0" in n for n in _STATE["notes"]))
+            del os.environ["QAT_QSNR_WATCHDOG"]
+            os.environ["QAT_QSNR_LABELS"] = '{"run": "smoke-1", "arm": "a"}'
+            case("身份标签由 QAT_QSNR_LABELS 透传（框架侧不认识轮次/任务）",
+                 _labels() == {"run": "smoke-1", "arm": "a"})
+            del os.environ["QAT_QSNR_LABELS"]
+            case("没给标签 ⇒ None（不猜、不报错）", _labels() is None)
+            # ⑤ 触发是 BaseException ⇒ `except Exception` 吞不掉（这是"真停"的机械保证）
+            case("QSNRWatchdogTrip 继承 BaseException（不许被 broad except 吞掉）",
+                 issubclass(QSNRWatchdogTrip, BaseException)
+                 and not issubclass(QSNRWatchdogTrip, Exception))
+            case("_ProbeForwardDone 同样吞不掉",
+                 issubclass(_ProbeForwardDone, BaseException)
+                 and not issubclass(_ProbeForwardDone, Exception))
+            # ⑤c ★ 标定批三形态真值表 ＋ **回放形态**（tester 第三次冒烟阻断）
+            #    `reset_attention_mask=False` ⇒ `sft_trainer.py:162-163` 令 `position_ids=None`
+            #    ⇒ 调用形态 `model(tokens, None, attention_mask, …)`。
+            #    三条都必须：① 不抛（尤其不许 `'NoneType' has no attribute 'detach'`）；
+            #    ② `calib` 恰好 3 槽、顺序不变；③ 回放 `inner(*calib)` 的**位置形态**与真实调用一致。
+            import torch as _torch
+
+            class _Rec(_torch.nn.Module):
+                def __init__(self):
+                    super().__init__()
+                    self.seen = None
+
+                def forward(self, *a, **kw):  # noqa: ARG002
+                    self.seen = (len(a), [None if x is None else type(x).__name__ for x in a])
+                    raise _ProbeForwardDone()
+
+            _tok = _torch.zeros(2, 4, dtype=_torch.long)
+            _pos = _torch.arange(4).unsqueeze(0).repeat(2, 1)
+            _mask = _torch.ones(2, 4, dtype=_torch.bool)
+            _truth = (("(tokens,pos,mask)", (_tok, _pos, _mask), "Tensor"),
+                      ("(tokens,None,mask)", (_tok, None, _mask), None),
+                      ("(tokens,pos,None)", (_tok, _pos, None), "Tensor"))
+            # ★ 步号来源已改成框架真实 iteration（`args.curr_iteration`）⇒
+            #   这里喂一个假 `megatron.training.global_vars`（只提供 `get_args`），让
+            #   `_real_iteration()` 走**真路径**：curr_iteration=0 ⇒ step=1，命中
+            #   下面的 `sample_steps=[1]`。绝不 mock 掉 `_real_iteration` 本身。
+            import types as _types
+
+            _mg_saved = {_k: sys.modules.get(_k) for _k in
+                         ("megatron", "megatron.training", "megatron.training.global_vars")}
+            _fake_args = _types.SimpleNamespace(curr_iteration=0)
+            try:
+                for _n in ("megatron", "megatron.training"):
+                    _pkg = _types.ModuleType(_n)
+                    _pkg.__path__ = []
+                    sys.modules[_n] = _pkg
+                _gv = _types.ModuleType("megatron.training.global_vars")
+                _gv.get_args = lambda: _fake_args
+                sys.modules["megatron.training.global_vars"] = _gv
+                sys.modules["megatron.training"].global_vars = _gv
+                sys.modules["megatron"].training = sys.modules["megatron.training"]
+
+                # ★步号来源：真函数读到假 args 的 curr_iteration。
+                case("★步号来源 = args.curr_iteration（读到 0）", _real_iteration() == 0)
+                _fake_args.curr_iteration = 149
+                case("★步号来源随框架 iteration 走（读到 149）", _real_iteration() == 149)
+                _fake_args.curr_iteration = 0
+                # ★取不到 ⇒ **响亮报错**（QATProbeConfigError，BaseException）
+                _gv.get_args = lambda: _types.SimpleNamespace()      # 无 curr_iteration
+                try:
+                    _real_iteration()
+                    case("★无 args.curr_iteration ⇒ 抛 QATProbeConfigError（不静默继续）", False)
+                except QATProbeConfigError:
+                    case("★无 args.curr_iteration ⇒ 抛 QATProbeConfigError（不静默继续）", True)
+
+                def _boom():
+                    raise AssertionError("args is not initialized.")
+
+                _gv.get_args = _boom
+                try:
+                    _real_iteration()
+                    case("★get_args() 未初始化 ⇒ 也抛 QATProbeConfigError", False)
+                except QATProbeConfigError:
+                    case("★get_args() 未初始化 ⇒ 也抛 QATProbeConfigError", True)
+                _gv.get_args = lambda: _fake_args
+
+                for _label, _args, _want_slot1 in _truth:
+                    _m = _Rec()
+                    _saved_state = dict(_STATE)
+                    _STATE.update(installed=True, probe_invalid=False, capturing=False, n_fwd=0,
+                                  seen_step=None, n_micro=1, sample_steps=[1], calib=None,
+                                  notes=[], act={}, modules=[], modules_meta={}, records=[],
+                                  by_step={}, trip=None, inner=_m)
+                    _real_stdout, _caught = sys.stdout, None
+                    try:
+                        sys.stdout = open(os.devnull, "w")
+                        try:
+                            _outer_pre_hook(None, _args, {})
+                        except BaseException as _exc:  # noqa: BLE001
+                            _caught = f"{type(_exc).__name__}: {_exc}"
+                        _calib = _STATE["calib"]
+                        _seen = _m.seen
+                    finally:
+                        sys.stdout.close()
+                        sys.stdout = _real_stdout
+                        _STATE.clear()
+                        _STATE.update(_saved_state)
+                    _slot1 = None if _calib is None or _calib[1] is None else type(_calib[1]).__name__
+                    case(f"标定批 {_label}：不抛、3 槽保序、None 留在原位"
+                         + (f"（实得槽1={_slot1}，异常={_caught}）" if _caught else ""),
+                         _caught is None and _calib is not None and len(_calib) == 3
+                         and _slot1 == _want_slot1)
+                    case(f"  回放形态 {_label}：inner(*calib) 与真实调用同形（3 位置参数）",
+                         _seen is not None and _seen[0] == 3 and _seen[1][1] == _want_slot1)
+            finally:
+                for _k, _v in _mg_saved.items():
+                    if _v is None:
+                        sys.modules.pop(_k, None)
+                    else:
+                        sys.modules[_k] = _v
+
+            # ⑤b 配置类错误也不许被 `install_on_model` 的
+            #     `except Exception` 收成 probe_invalid（reviewer §2-4）
+            case("QATProbeConfigError 也不被 broad except 收走（配置错 ⇒ 当场炸穿）",
+                 issubclass(QATProbeConfigError, BaseException)
+                 and not issubclass(QATProbeConfigError, Exception))
+            _saved_ev = os.environ.get("QAT_QSNR_EVERY")
+            try:
+                os.environ["QAT_QSNR_EVERY"] = "abc"
+                try:
+                    sample_every()
+                    case("QAT_QSNR_EVERY=abc ⇒ 抛 QATProbeConfigError", False)
+                except QATProbeConfigError:
+                    case("QAT_QSNR_EVERY=abc ⇒ 抛 QATProbeConfigError", True)
+                except Exception:  # noqa: BLE001 —— 抛成 ValueError 就是被 broad except 收走的那一类
+                    case("QAT_QSNR_EVERY=abc ⇒ 抛 QATProbeConfigError（**不是**普通 Exception）", False)
+            finally:
+                os.environ.pop("QAT_QSNR_EVERY", None)
+                if _saved_ev is not None:
+                    os.environ["QAT_QSNR_EVERY"] = _saved_ev
+            # ⑥ probe_invalid 场景：落盘要带原因、且**不**触发停止
+            _STATE.update(probe_invalid=True, probe_invalid_reason="测试用", trip=None)
+            _write_current()
+            doc = json.loads(open(os.path.join(td, os.path.basename(_qsnr_path(_rank()))),
+                                  encoding="utf-8").read())
+            case("probe_invalid 落盘带原因", doc["probe_invalid"] is True
+                 and doc["probe_invalid_reason"] == "测试用")
+            case(f"落点文件名（rank={_rank()}）= {os.path.basename(_qsnr_path(_rank()))}",
+                 os.path.isfile(os.path.join(td, os.path.basename(_qsnr_path(_rank())))))
+            case("rank0 的落点就是判据点名的 eval_clamp_qsnr.json",
+                 os.path.basename(_qsnr_path(0)) == "eval_clamp_qsnr.json")
+    finally:
+        _STATE.clear()
+        _STATE.update(saved_state)
+        os.environ.clear()
+        os.environ.update(saved_env)
+
+    if fails:
+        print(f"\nSELFTEST FAILED —— 执行了 {checks} 条检查，{len(fails)} 条不过：")
+        for f in fails:
+            print(f"    - {f}")
+        return 1
+    print(f"\nSELFTEST PASSED —— 执行了 {checks} 条检查，0 条不过")
+    return 0
+
+
+def _watchdog_silent(agg: float) -> bool:
+    """复算一次"不触发"（临时把基准抬到不会跌的位置）。"""
+    st = _STATE
+    keep = dict(st["by_step"])
+    try:
+        st["by_step"] = {BASELINE_STEP: agg + 1.0}
+        _watchdog(11, agg, agg, agg)
+        return st["trip"] is None
+    except QSNRWatchdogTrip:
+        return False
+    finally:
+        st["by_step"] = keep
+
+
+if __name__ == "__main__":
+    if len(sys.argv) > 1 and sys.argv[1] == "--selftest":
+        raise SystemExit(selftest())
+    print(__doc__)
+    print("用法：python3 mindspeed/core/qat/qsnr_probe.py --selftest")
