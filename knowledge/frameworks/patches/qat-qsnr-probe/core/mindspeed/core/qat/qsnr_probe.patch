+def _real_iteration() -> int:
+    """探针步号的**唯一**来源：框架真实训练 iteration（0-based）。
+
+    ★ 为什么是 `args.curr_iteration`（读源码确认，不是猜）：
+      · 实际跑的循环是 MindSpeed-LLM 的 `train()`
+        —— `MindSpeed-LLM/posttrain_gpt.py:8 → AutoTrainer.train` →
+        `mindspeed_llm/training/training.py:547` 调本文件的 `train()`；
+      · 它在**每次 `train_step` 之前**赋值 `args.curr_iteration = iteration`
+        —— `MindSpeed-LLM/mindspeed_llm/training/training.py:733`（上游同款
+        `Megatron-LM/megatron/training/training.py:1990`）；
+      · `train_step` 里的**训练**前向读到的就是当前步；而 `iteration += 1` **之后**
+        才做的 mid-training validation（`…/training.py:809-…` 调 `evaluate_*`）
+        **不会**改写 `args.curr_iteration` ⇒ val 前向与刚跑完的训练步**同号**，
+        被 `_outer_pre_hook` 的 `seen_step` 去重挡掉。
+      · **不用 `args.iteration`**：它在循环里**不**回写，循环前从 ckpt 读一次后
+        一直停在初值（`Megatron-LM/megatron/training/training.py:1828`
+        `iteration = args.iteration`；全文件里循环内唯一的写入是
+        `MindSpeed-LLM/mindspeed_llm/training/training.py:806` 的
+        `enable_high_availability` 分支）⇒ 循环中途取到的是过期值。
+
+    ★ 取不到 ⇒ `QATProbeConfigError`（继承 `BaseException` ⇒ 不被任何
+      `except Exception` 收走）⇒ **响亮报错、当场炸穿**。绝不退回前向计数、
+      绝不猜一个默认步号（本项目明令禁止静默 fallback）。
+    """
+    try:
+        from megatron.training.global_vars import get_args
+    except Exception as exc:  # noqa: BLE001
+        raise QATProbeConfigError(
+            "取不到框架真实 iteration：无法 import "
+            f"megatron.training.global_vars.get_args（{type(exc).__name__}: {exc}）"
+            " ⇒ 拒绝继续（本探针的步号只从框架真实 iteration 取，不退回前向计数）")
+    try:
+        args = get_args()
+    except Exception as exc:  # noqa: BLE001
+        raise QATProbeConfigError(
+            f"取不到框架真实 iteration：get_args() 失败（{type(exc).__name__}: {exc}）"
+            " ⇒ 拒绝继续（不猜一个默认步号）")
+    if args is None:
+        raise QATProbeConfigError(
+            "取不到框架真实 iteration：get_args() 返回 None ⇒ 拒绝继续")
+    cur = getattr(args, "curr_iteration", None)
+    if cur is None:
+        raise QATProbeConfigError(
+            "取不到框架真实 iteration：args.curr_iteration 不存在或为 None"
+            "（Megatron 在 train_step 之前才赋值它；例如 --skip-train 时训练循环不跑）"
+            " ⇒ 拒绝继续（不静默继续，也不退回前向计数）")
+    try:
+        return int(cur)
+    except (TypeError, ValueError):
+        raise QATProbeConfigError(
+            f"args.curr_iteration={cur!r} 不是整数 ⇒ 拒绝继续（不猜一个默认步号）")
+
