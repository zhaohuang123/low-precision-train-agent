+def _qsnr_path(rank: int) -> str:
+    name = "eval_clamp_qsnr.json" if rank == 0 else f"eval_clamp_qsnr.rank{rank}.json"
+    return os.path.join(_out_dir(), name)
+
+
+def _atomic_write_json(path: str, payload) -> None:
+    d = os.path.dirname(path) or "."
+    os.makedirs(d, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=d, prefix=".qsnr-", suffix=".tmp")
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as fh:
+            json.dump(payload, fh, ensure_ascii=False, indent=2, allow_nan=False)
+            fh.flush()
+            os.fsync(fh.fileno())
+        os.replace(tmp, path)
+    finally:
+        if os.path.exists(tmp):
+            os.unlink(tmp)
+
+
+# ---------------------------------------------------------------------------
+# 装配
+# ---------------------------------------------------------------------------
+def _unwrap(m):
+    seen = set()
+    while hasattr(m, "module") and getattr(m, "module", None) is not None and id(m) not in seen:
+        seen.add(id(m))
+        m = m.module
+    return m
+
+
+def _is_quantized_linear(name: str):
+    """按**框架自己的槽位表**判"这是不是一个被量化线性层"（不另立一份真相）。"""
+    parsed = parse_native(name)
+    if parsed is None:
+        return None
+    idx, slot = parsed
+    if slot not in ONE_TO_ONE and slot not in FUSED:
+        return None
+    return idx, slot
+
