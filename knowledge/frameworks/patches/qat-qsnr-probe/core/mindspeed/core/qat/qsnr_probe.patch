+def _out_dir() -> str:
+    # 落点只由 `QAT_QSNR_OUT` 决定；不设就落到 cwd（单元冒烟场景，**不**猜一个工程路径）。
+    # ★ 框架侧不认识任何"工程/轮次"级的目录约定 —— 那是调用方 export 进来的事。
+    ev = os.environ.get("QAT_QSNR_OUT") or ""
