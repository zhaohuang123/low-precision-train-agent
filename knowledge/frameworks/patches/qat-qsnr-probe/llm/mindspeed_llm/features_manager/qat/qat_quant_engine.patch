+    @staticmethod
+    def _register_qsnr_probe(pm: MindSpeedPatchesManager, args, scheme):
+        """`QAT_QSNR_PROBE=1` 时把在线 QSNR 探针挂到 `get_model` 上。
+
+        ★ 只在 QAT 训练进程里注册 —— 非训练进程**不许**装探针：
+          装了会往 `<QAT_QSNR_OUT>` 写它自己那份
+          "根本没采到样"的记录，把好数据盖掉。
+        """
+        import os
+
+        if os.environ.get("QAT_QSNR_PROBE", "0") not in ("1", "2"):
+            return
+        if scheme not in _QAT_SCHEMES:
+            print(
+                f"[qat-qsnr] QAT_QSNR_PROBE=1 但本进程 --qat-scheme={scheme!r} ⇒ 探针**不装**"
+                "（非 QAT 训练进程；训练进程里会打 `[qat-qsnr] installed …` 自证行）",
+                flush=True,
+            )
+            return
+        from mindspeed.core.qat.qsnr_probe import qat_qsnr_get_model_wrapper
+
+        pm.register_patch(
+            'megatron.training.training.get_model',
+            qat_qsnr_get_model_wrapper,
+        )
+        print(
+            f"[qat-qsnr] 已注册 get_model 探针补丁（scheme={scheme}，采样间隔 "
+            f"QAT_QSNR_EVERY={os.environ.get('QAT_QSNR_EVERY', '缺')}）"
+            " —— 装配与每次采样在模型建好后出现",
+            flush=True,
+        )
